#version 450
// Rotate (and zoom) the headset view around its center so the horizon stays level.
// Compiled on the PC with: glslc -O -mfmt=c src/stabilize.comp -o src/stabilize_spv.h
layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = 0) uniform sampler2D src;              // Headset view (usually an sRGB format).
layout(binding = 1, rgba8) uniform writeonly image2D dst; // Output, written as sRGB-encoded bytes.

layout(push_constant) uniform Params {
    vec2 uvMin;      // Valid area of the source texture.
    vec2 uvMax;
    vec2 outSize;    // Output size in pixels.
    vec2 srcSize;    // Size of the valid source area in pixels.
    float cosA;      // Rotation, counterclockwise as seen on screen.
    float sinA;
    float zoom;
    int srgbSource;  // 1 = sampling returns linear values; encode them back to sRGB.
} p;

vec3 linearToSrgb(vec3 c) {
    return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, step(vec3(0.0031308), c));
}

// Source color (linear if srgbSource) at an output position in pixels; black outside the source.
vec3 sampleAt(vec2 pos) {
    // The output stretches the source to fill it (like the plain blit), so the two aspect ratios usually differ
    // (e.g. a square eye view on a 16:9 TV). Rotate in *source* pixel space, origin at the center, y down: there the
    // pixels are square, so the rotation is rigid and cancels the HMD roll exactly. Rotating in output pixel space
    // would mix in the stretch and get the horizon angle wrong (roughly half the tilt left over on a 16:9 TV).
    vec2 n = pos / p.outSize - 0.5;  // Output position, -0.5..0.5.
    vec2 q = n * p.srcSize;          // Same point in source pixels.
    vec2 s = vec2(p.cosA * q.x - p.sinA * q.y, p.sinA * q.x + p.cosA * q.y) / p.zoom;
    vec2 uv = s / p.srcSize + 0.5;
    if (any(lessThan(uv, vec2(0.0))) || any(greaterThan(uv, vec2(1.0)))) return vec3(0.0);
    return texture(src, mix(p.uvMin, p.uvMax, uv)).rgb;
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    if (px.x >= int(p.outSize.x) || px.y >= int(p.outSize.y)) return;

    // 2x2 samples per output pixel: the output is smaller than the source, and with one sample the stair steps along
    // near-horizontal edges crawl as the angle follows small head movements (the lines seem to jitter).
    vec2 c = vec2(px);
    vec3 color = 0.25 * (sampleAt(c + vec2(0.25, 0.25)) + sampleAt(c + vec2(0.75, 0.25)) +
                         sampleAt(c + vec2(0.25, 0.75)) + sampleAt(c + vec2(0.75, 0.75)));
    if (p.srgbSource == 1) color = linearToSrgb(color);
    imageStore(dst, px, vec4(color, 1.0));
}
