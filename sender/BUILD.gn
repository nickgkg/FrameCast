# FrameCast low-latency Cast Streaming sender. Copied into the openscreen tree
# as cast/framecast_sender by build-sender.sh.

import("//build_overrides/build.gni")
import("../../gni/openscreen.gni")

openscreen_executable("framecast_sender") {
  deps = [
    "../../platform",
    "../../platform:standalone_impl",
    "../../third_party/getopt",
    "../../third_party/jsoncpp",
    "../../util",
    "../common:certificate_boringssl",
    "../common:public",
    "../common/channel/proto:channel_proto",
    "../sender:channel",
    "../streaming:common",
    "../streaming:sender",
  ]
  sources = [
    "framecast_agent.cc",
    "framecast_agent.h",
    "h264_pipe_sender.cc",
    "h264_pipe_sender.h",
    "main.cc",
    "opus_pipe_sender.cc",
    "opus_pipe_sender.h",
  ]
  configs = [ "../common:certificate_config" ]
}
